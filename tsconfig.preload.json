{
  "extends": "@tsconfig/node22",
  "include": ["src/app/preload.ts"],
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2023",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "electron"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0"
  }
}
